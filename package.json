{
  "name": "sitebot-cli",
  "version": "0.1.0",
  "description": "Fast terminal SEO checker",
  "author": "Abdelrahman Ragab",
  "keywords": ["seo", "geo", "audit", "cli", "website"],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Abdelrahman5243/sitebot-cli.git"
  },
  "bugs": {
    "url": "https://github.com/Abdelrahman5243/sitebot-cli/issues"
  },
  "files": ["dist", "README.md", "LICENSE"],
  "type": "module",
  "bin": {
    "sitebot": "dist/cli.js"
  },
  "scripts": {
    "dev": "tsx src/cli.ts",
    "build": "tsup src/cli.ts --format esm --clean",
    "start": "node dist/cli.js",
    "check": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "prepublishOnly": "npm run check && npm test && npm run build"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@clack/prompts": "^1.7.0",
    "cheerio": "^1.0.0-rc.12",
    "commander": "^14.0.0",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsup": "^8.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0"
  }
}
